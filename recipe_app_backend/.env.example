# Backend environment variables for Recipe Hub (FastAPI)

# Database connection (provide full URL string)
# e.g. postgresql+psycopg://user:pass@localhost:5432/recipehub
DATABASE_URL=

# JWT secret key for signing access tokens (REQUIRED)
JWT_SECRET=replace-with-a-secure-random-string

# Comma-separated list of allowed origins for CORS
# Ensure the frontend origin (http://localhost:3000) is present during local dev.
CORS_ORIGINS=http://localhost:3000

# Directory path where uploaded media will be stored (writeable by the server)
MEDIA_DIR=./media

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
